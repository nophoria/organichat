TitleBar {
  background: $surface;
}

ClearMsg, ConnectMsg {
  padding: 1;
  align: center middle;
  color: $text-muted;
}

ClearMsg {
  width: 100%;
}

StartDialog {
  padding: 1;
}

#saveddevtitle {
  align: center middle;
  width: 100%;
  padding: 1;
}

ListItem {
  padding: 1;
}

#titletext, #connmsg {
  padding: 1 1;
  width: 2fr;
  align: left middle;
  height: auto;
}

#ipentry {
  width: 1fr;
}

#passentry {
  width: 1fr;
}

#connmsg {
  width: 2fr;
}

#connload {
  padding: 1 3 0 0;
  width: auto;
}

#leavebutton {
  height: 100%;
  text-align: center;
  content-align: center middle;
  width: auto;
}

#leavebutton, #connload {
  align: right middle;
}

MsgInput, MsgSend {
  height: 5;
}

#msgsend {
  margin: 0 1;
  background: $surface;
}

MsgHistory {
  padding: 0;
}

Msg {
  padding: 1 2;
  height: auto;
  opacity: 0;
}

.msgtitle {
  border: solid $background;
}

.msgcontent {
  border: solid $surface;
  border-title-color: $text-muted;
  height: auto;
  background: $background;
  width: 100%;
}